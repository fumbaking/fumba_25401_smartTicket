<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="smartticket_defs" targetNamespace="https://github.com/fumbaking/fumba_25401_smartTicket" exporter="SmartTicket phase1 generator" exporterVersion="1.0">
<bpmn:collaboration id="collab"><bpmn:documentation>SmartTicket: ticket booking, payment and gate admission. INSY 8311 Capstone Phase I, FUMBA Huriro (25401).</bpmn:documentation><bpmn:participant id="pool" name="SmartTicket: booking to admission" processRef="booking_to_admission"/></bpmn:collaboration>
<bpmn:process id="booking_to_admission" name="Ticket booking, payment and gate admission" isExecutable="false"><bpmn:laneSet id="lanes"><bpmn:lane id="lane_customer" name="Customer (ticket buyer)"><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef><bpmn:flowNodeRef>e_expired</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>e_abandon</bpmn:flowNodeRef><bpmn:flowNodeRef>t14</bpmn:flowNodeRef><bpmn:flowNodeRef>t15</bpmn:flowNodeRef><bpmn:flowNodeRef>bt_timer</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_db" name="SmartTicket Database (Oracle PDB, PL/SQL)"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>e_refused</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef><bpmn:flowNodeRef>t11</bpmn:flowNodeRef><bpmn:flowNodeRef>t12</bpmn:flowNodeRef><bpmn:flowNodeRef>s_job</bpmn:flowNodeRef><bpmn:flowNodeRef>t13</bpmn:flowNodeRef><bpmn:flowNodeRef>e_released</bpmn:flowNodeRef><bpmn:flowNodeRef>t17</bpmn:flowNodeRef><bpmn:flowNodeRef>g5</bpmn:flowNodeRef><bpmn:flowNodeRef>t18</bpmn:flowNodeRef><bpmn:flowNodeRef>t19</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_pay" name="Payment Provider (MoMo / card)"><bpmn:flowNodeRef>t9</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_gate" name="Gate Staff (venue entry)"><bpmn:flowNodeRef>t16</bpmn:flowNodeRef><bpmn:flowNodeRef>t20</bpmn:flowNodeRef><bpmn:flowNodeRef>e_admitted</bpmn:flowNodeRef><bpmn:flowNodeRef>t21</bpmn:flowNodeRef><bpmn:flowNodeRef>e_denied</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_org" name="Event Organiser (Power BI)"><bpmn:flowNodeRef>s_org</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>s_mon</bpmn:flowNodeRef><bpmn:flowNodeRef>t22</bpmn:flowNodeRef><bpmn:flowNodeRef>g6</bpmn:flowNodeRef><bpmn:flowNodeRef>t23</bpmn:flowNodeRef><bpmn:flowNodeRef>e_decided</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="s_org" name="Event approved for sale"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="t1" name="1. Publish event, prices and seats&#10;C: EVENTS (SCHEDULED)&#10;C: EVENT_PRICES (per tier)&#10;C: TICKETS (AVAILABLE)"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t2" name="2. Browse open events and free seats&#10;R: EVENTS, EVENT_PRICES&#10;R: TICKETS via fn_available_seats"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t3" name="3. Select seats (max 6 per event)"><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t4" name="4. Validate booking request&#10;R: EVENTS (status, sales window)&#10;R: TICKETS (status)&#10;R: fn_customer_ticket_count"><bpmn:documentation>pkg_ticketing.sp_book_tickets</bpmn:documentation><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g1" name="Event open for sale?"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t5" name="5. Refuse: event closed&#10;C: AUDIT_LOG (DENIED, ORA-20003)"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e_refused" name="Booking refused (customer told why)"><bpmn:incoming>f7</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="g2" name="Seats free and customer within 6 tickets?"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t6" name="6. Refuse seats, log attempt&#10;C: AUDIT_LOG (DENIED, ORA-20001 / ORA-20002)"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t7" name="7. Hold seats, create booking&#10;C: BOOKINGS (PENDING, +15 min)&#10;C: BOOKING_ITEMS (price paid)&#10;U: TICKETS → HELD&#10;C: AUDIT_LOG (BOOK)"><bpmn:documentation>pkg_ticketing.sp_book_tickets</bpmn:documentation><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="t8" name="8. Pay with MoMo or card"><bpmn:incoming>f12</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e_expired" name="Hold expired (15 min)"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="t9" name="9. Process payment, return reference"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task>
<bpmn:serviceTask id="t10" name="10. Record payment, check amount&#10;C: PAYMENTS (PENDING)&#10;R: BOOKING_ITEMS (fn_booking_total)"><bpmn:documentation>pkg_ticketing.sp_record_payment</bpmn:documentation><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g3" name="Approved and amount = booking total?"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:outgoing>f21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t11" name="11. Reject payment, log attempt&#10;U: PAYMENTS → FAILED&#10;C: AUDIT_LOG (DENIED, ORA-20005)"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g4" name="Retry payment?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e_abandon" name="Payment abandoned"><bpmn:incoming>f20</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="t12" name="12. Confirm booking, issue tickets&#10;U: PAYMENTS → COMPLETED&#10;U: BOOKINGS → CONFIRMED&#10;U: TICKETS → SOLD&#10;C: AUDIT_LOG (PAY)"><bpmn:documentation>pkg_ticketing.sp_record_payment</bpmn:documentation><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:serviceTask>
<bpmn:startEvent id="s_job" name="Every minute (DBMS_SCHEDULER)"><bpmn:outgoing>f22</bpmn:outgoing><bpmn:timerEventDefinition id="s_job_def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
<bpmn:serviceTask id="t13" name="13. Release expired holds&#10;R: BOOKINGS (PENDING, expired)&#10;U: BOOKINGS → EXPIRED&#10;U: TICKETS → AVAILABLE&#10;C: AUDIT_LOG"><bpmn:documentation>sp_release_expired_holds (cursor)</bpmn:documentation><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e_released" name="Seats back on sale"><bpmn:incoming>f23</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="t14" name="14. Receive e-ticket (QR code)&#10;R: TICKETS, BOOKING_ITEMS"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t15" name="15. Arrive on event day, show QR"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t16" name="16. Scan QR code at gate"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t17" name="17. Validate ticket&#10;R: TICKETS (status, event)&#10;R: GATE_SCANS (earlier scans)"><bpmn:documentation>pkg_gate.sp_scan_ticket</bpmn:documentation><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g5" name="Ticket SOLD, for this event, not yet used?"><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing><bpmn:outgoing>f30</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t18" name="18. Record admission&#10;C: GATE_SCANS (ADMITTED)&#10;U: TICKETS → USED&#10;C: AUDIT_LOG (SCAN)"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="t19" name="19. Record denied scan&#10;C: GATE_SCANS (DENIED, reason)&#10;C: AUDIT_LOG (DENIED, ORA-20004)"><bpmn:documentation>trg_single_entry</bpmn:documentation><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f33</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="t20" name="20. Admit attendee"><bpmn:incoming>f31</bpmn:incoming><bpmn:outgoing>f32</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e_admitted" name="Attendee admitted"><bpmn:incoming>f32</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="t21" name="21. Refuse entry, send to help desk"><bpmn:incoming>f33</bpmn:incoming><bpmn:outgoing>f34</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e_denied" name="Entry refused"><bpmn:incoming>f34</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="s_mon" name="Sales open / event day"><bpmn:outgoing>f35</bpmn:outgoing><bpmn:conditionalEventDefinition id="s_mon_def"><bpmn:condition xsi:type="bpmn:tFormalExpression">sales are open or it is event day</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:startEvent>
<bpmn:userTask id="t22" name="22. Monitor live dashboard&#10;R: BOOKINGS, PAYMENTS, TICKETS&#10;R: GATE_SCANS, AUDIT_LOG&#10;R: fn_occupancy_pct, pkg_reports"><bpmn:documentation>Power BI, DirectQuery</bpmn:documentation><bpmn:incoming>f35</bpmn:incoming><bpmn:incoming>f40</bpmn:incoming><bpmn:outgoing>f37</bpmn:outgoing><bpmn:property id="t22_in" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="f36"><bpmn:sourceRef>ds</bpmn:sourceRef><bpmn:targetRef>t22_in</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="g6" name="Action needed? (sell-out, fraud spike, slow gate)"><bpmn:incoming>f37</bpmn:incoming><bpmn:outgoing>f38</bpmn:outgoing><bpmn:outgoing>f40</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t23" name="23. Decide: open gates, release sections, flag a buyer"><bpmn:incoming>f38</bpmn:incoming><bpmn:outgoing>f39</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e_decided" name="Decision taken"><bpmn:incoming>f39</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="bt_timer" name="15 min" attachedToRef="t8"><bpmn:outgoing>f13</bpmn:outgoing><bpmn:timerEventDefinition id="bt_timer_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:dataStoreReference id="ds" name="SmartTicket PDB (16 tables + AUDIT_LOG)"/>
<bpmn:sequenceFlow id="f1" sourceRef="s_org" targetRef="t1"/>
<bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" name="event on sale"/>
<bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/>
<bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="t4" name="customer, event, seat list"/>
<bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="g1"/>
<bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t5" name="No"/>
<bpmn:sequenceFlow id="f7" sourceRef="t5" targetRef="e_refused"/>
<bpmn:sequenceFlow id="f8" sourceRef="g1" targetRef="g2" name="Yes"/>
<bpmn:sequenceFlow id="f9" sourceRef="g2" targetRef="t6" name="No"/>
<bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t3" name="choose other seats"/>
<bpmn:sequenceFlow id="f11" sourceRef="g2" targetRef="t7" name="Yes"/>
<bpmn:sequenceFlow id="f12" sourceRef="t7" targetRef="t8" name="booking no., total"/>
<bpmn:sequenceFlow id="f13" sourceRef="bt_timer" targetRef="e_expired"/>
<bpmn:sequenceFlow id="f14" sourceRef="t8" targetRef="t9" name="amount, phone / card"/>
<bpmn:sequenceFlow id="f15" sourceRef="t9" targetRef="t10" name="reference, result"/>
<bpmn:sequenceFlow id="f16" sourceRef="t10" targetRef="g3"/>
<bpmn:sequenceFlow id="f17" sourceRef="g3" targetRef="t11" name="No"/>
<bpmn:sequenceFlow id="f18" sourceRef="t11" targetRef="g4" name="payment failed"/>
<bpmn:sequenceFlow id="f19" sourceRef="g4" targetRef="t8" name="Yes (hold still valid)"/>
<bpmn:sequenceFlow id="f20" sourceRef="g4" targetRef="e_abandon" name="No"/>
<bpmn:sequenceFlow id="f21" sourceRef="g3" targetRef="t12" name="Yes"/>
<bpmn:sequenceFlow id="f22" sourceRef="s_job" targetRef="t13"/>
<bpmn:sequenceFlow id="f23" sourceRef="t13" targetRef="e_released"/>
<bpmn:sequenceFlow id="f24" sourceRef="t12" targetRef="t14" name="QR = ticket_id"/>
<bpmn:sequenceFlow id="f25" sourceRef="t14" targetRef="t15"/>
<bpmn:sequenceFlow id="f26" sourceRef="t15" targetRef="t16" name="QR code"/>
<bpmn:sequenceFlow id="f27" sourceRef="t16" targetRef="t17" name="ticket_id, gate"/>
<bpmn:sequenceFlow id="f28" sourceRef="t17" targetRef="g5"/>
<bpmn:sequenceFlow id="f29" sourceRef="g5" targetRef="t18" name="Yes"/>
<bpmn:sequenceFlow id="f30" sourceRef="g5" targetRef="t19" name="No"/>
<bpmn:sequenceFlow id="f31" sourceRef="t18" targetRef="t20" name="ADMITTED"/>
<bpmn:sequenceFlow id="f32" sourceRef="t20" targetRef="e_admitted"/>
<bpmn:sequenceFlow id="f33" sourceRef="t19" targetRef="t21" name="DENIED + reason"/>
<bpmn:sequenceFlow id="f34" sourceRef="t21" targetRef="e_denied"/>
<bpmn:sequenceFlow id="f35" sourceRef="s_mon" targetRef="t22"/>
<bpmn:sequenceFlow id="f37" sourceRef="t22" targetRef="g6"/>
<bpmn:sequenceFlow id="f38" sourceRef="g6" targetRef="t23" name="Yes"/>
<bpmn:sequenceFlow id="f39" sourceRef="t23" targetRef="e_decided"/>
<bpmn:sequenceFlow id="f40" sourceRef="g6" targetRef="t22" name="No: keep monitoring"/>
<bpmn:textAnnotation id="legend"><bpmn:text>Data activities: C = create a record, R = retrieve / read, U = update (new status). D = delete / archive: none. Records are never deleted; cancelled or expired rows only change status and AUDIT_LOG is append-only. ORA-200xx = error raised by PL/SQL. Labels on arrows show the information passed.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
<bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="collab">
<bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true"><dc:Bounds x="0" y="70" width="3200" height="1110"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_customer_di" bpmnElement="lane_customer" isHorizontal="true" bioc:stroke="#555555" bioc:fill="#F3F8FF" color:border-color="#555555" color:background-color="#F3F8FF"><dc:Bounds x="30" y="70" width="3170" height="210"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_db_di" bpmnElement="lane_db" isHorizontal="true" bioc:stroke="#555555" bioc:fill="#F4FBF4" color:border-color="#555555" color:background-color="#F4FBF4"><dc:Bounds x="30" y="280" width="3170" height="350"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_pay_di" bpmnElement="lane_pay" isHorizontal="true" bioc:stroke="#555555" bioc:fill="#FFF9F0" color:border-color="#555555" color:background-color="#FFF9F0"><dc:Bounds x="30" y="630" width="3170" height="140"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_gate_di" bpmnElement="lane_gate" isHorizontal="true" bioc:stroke="#555555" bioc:fill="#FBF5FF" color:border-color="#555555" color:background-color="#FBF5FF"><dc:Bounds x="30" y="770" width="3170" height="200"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="lane_org_di" bpmnElement="lane_org" isHorizontal="true" bioc:stroke="#555555" bioc:fill="#F7F7F7" color:border-color="#555555" color:background-color="#F7F7F7"><dc:Bounds x="30" y="970" width="3170" height="210"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s_org_di" bpmnElement="s_org" bioc:stroke="#2E7D32" bioc:fill="#E8F5E9" color:border-color="#2E7D32" color:background-color="#E8F5E9"><dc:Bounds x="182" y="1047" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="150" y="1087" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t1_di" bpmnElement="t1" bioc:stroke="#1F1F1F" bioc:fill="#FFFFFF" color:border-color="#1F1F1F" color:background-color="#FFFFFF"><dc:Bounds x="242" y="1011" width="196" height="108"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t2_di" bpmnElement="t2" bioc:stroke="#1F1F1F" bioc:fill="#FFFFFF" color:border-color="#1F1F1F" color:background-color="#FFFFFF"><dc:Bounds x="242" y="128.5" width="196" height="93"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t3_di" bpmnElement="t3" bioc:stroke="#666666" bioc:fill="#FFFFFF" color:border-color="#666666" color:background-color="#FFFFFF"><dc:Bounds x="465" y="142" width="150" height="66"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t4_di" bpmnElement="t4" bioc:stroke="#1F1F1F" bioc:fill="#FFFFFF" color:border-color="#1F1F1F" color:background-color="#FFFFFF"><dc:Bounds x="622" y="318.5" width="196" height="123"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="g1_di" bpmnElement="g1" bioc:stroke="#8D6E00" bioc:fill="#FFFDE7" color:border-color="#8D6E00" color:background-color="#FFFDE7"><dc:Bounds x="864" y="354" width="52" height="52"/><bpmndi:BPMNLabel><dc:Bounds x="814" y="310" width="152" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t5_di" bpmnElement="t5" bioc:stroke="#1F1F1F" bioc:fill="#FFFFFF" color:border-color="#1F1F1F" color:background-color="#FFFFFF"><dc:Bounds x="815" y="501" width="150" height="78"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="e_refused_di" bpmnElement="e_refused" bioc:stroke="#B71C1C" bioc:fill="#FFEBEE" color:border-color="#B71C1C" color:background-color="#FFEBEE"><dc:Bounds x="712" y="522" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="680" y="562" width="100" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="g2_di" bpmnElement="g2" bioc:stroke="#8D6E00" bioc:fill="#FFFDE7" color:border-color="#8D6E00" color:background-color="#FFFDE7"><dc:Bounds x="1034" y="354" width="52" height="52"/><bpmndi:BPMNLabel><dc:Bounds x="984" y="310" width="152" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="t6_di" bpmnElement="t6" bioc:stroke="#1F1F1F" bioc:fill="#FFFFFF" color:border-color="#1F1F1F" color:background-color="#FFFFFF"><dc:Bounds x="985" y="493.5" width="150" height="93"/></bpmndi:BPMNShape>
