<mxfile host="app.diagrams.net" agent="SmartTicket phase1 generator"><diagram id="smartticket-bpmn" name="Booking to admission"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3300" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;SmartTicket: Ticket Booking, Payment and Gate Admission&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;BPMN 2.0 process model with swimlanes · INSY 8311 Capstone Phase I · FUMBA Huriro (25401)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="4" width="3200" height="56" as="geometry"/></mxCell><mxCell id="pool" value="SmartTicket: booking to admission" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=0;startSize=30;horizontalStack=0;fontSize=12;fillColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="3200" height="1110" as="geometry"/></mxCell><mxCell id="lane_customer" value="Customer&#xa;(ticket buyer)" style="swimlane;html=0;horizontal=0;startSize=120;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#F3F8FF;swimlaneFillColor=#F3F8FF;strokeColor=#888888;" vertex="1" parent="pool"><mxGeometry x="30" y="0" width="3170" height="210" as="geometry"/></mxCell><mxCell id="lane_db" value="SmartTicket Database&#xa;(Oracle PDB:&#xa;PL/SQL packages,&#xa;triggers, scheduler job)" style="swimlane;html=0;horizontal=0;startSize=120;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#F4FBF4;swimlaneFillColor=#F4FBF4;strokeColor=#888888;" vertex="1" parent="pool"><mxGeometry x="30" y="210" width="3170" height="350" as="geometry"/></mxCell><mxCell id="lane_pay" value="Payment Provider&#xa;(MTN MoMo / card,&#xa;external)" style="swimlane;html=0;horizontal=0;startSize=120;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#FFF9F0;swimlaneFillColor=#FFF9F0;strokeColor=#888888;" vertex="1" parent="pool"><mxGeometry x="30" y="560" width="3170" height="140" as="geometry"/></mxCell><mxCell id="lane_gate" value="Gate Staff&#xa;(venue entry)" style="swimlane;html=0;horizontal=0;startSize=120;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#FBF5FF;swimlaneFillColor=#FBF5FF;strokeColor=#888888;" vertex="1" parent="pool"><mxGeometry x="30" y="700" width="3170" height="200" as="geometry"/></mxCell><mxCell id="lane_org" value="Event Organiser&#xa;(Power BI&#xa;dashboard)" style="swimlane;html=0;horizontal=0;startSize=120;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#F7F7F7;swimlaneFillColor=#F7F7F7;strokeColor=#888888;" vertex="1" parent="pool"><mxGeometry x="30" y="900" width="3170" height="210" as="geometry"/></mxCell><mxCell id="s_org" value="Event approved for sale" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=10;labelBackgroundColor=none;outline=standard;symbol=general;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=80;" vertex="1" parent="lane_org"><mxGeometry x="152" y="77" width="36" height="36" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;1. Publish event, prices and seats&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;EVENTS (SCHEDULED)&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;EVENT_PRICES (per tier)&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS (AVAILABLE)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_org"><mxGeometry x="222" y="52" width="176" height="86" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;2. Browse open events and free seats&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;EVENTS, EVENT_PRICES&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS via fn_available_seats&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_customer"><mxGeometry x="222" y="69" width="176" height="72" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;3. Select seats (max 6 per event)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_customer"><mxGeometry x="435" y="72" width="150" height="66" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;4. Validate booking request&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9.5px&quot;&gt;pkg_ticketing.sp_book_tickets&lt;/i&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;EVENTS (status, sales window)&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS (status)&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;fn_customer_ticket_count&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="602" y="51" width="176" height="98" as="geometry"/></mxCell><mxCell id="g1" value="Event open for sale?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;gwType=exclusive;whiteSpace=wrap;fontSize=10.5;fillColor=#FFFDE7;strokeColor=#8D6E00;labelBackgroundColor=none;verticalLabelPosition=top;verticalAlign=bottom;labelWidth=150;" vertex="1" parent="lane_db"><mxGeometry x="834" y="74" width="52" height="52" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;5. Refuse: event closed&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;AUDIT_LOG (DENIED,&lt;br&gt;&lt;font color=&quot;undefined&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ORA-20003)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="785" y="224" width="150" height="72" as="geometry"/></mxCell><mxCell id="e_refused" value="Booking refused&lt;br&gt;(customer told why)" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=10;labelBackgroundColor=none;outline=end;symbol=terminate2;fillColor=#FFEBEE;strokeColor=#B71C1C;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=110;" vertex="1" parent="lane_db"><mxGeometry x="682" y="242" width="36" height="36" as="geometry"/></mxCell><mxCell id="g2" value="Seats free and customer within 6 tickets?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;gwType=exclusive;whiteSpace=wrap;fontSize=10.5;fillColor=#FFFDE7;strokeColor=#8D6E00;labelBackgroundColor=none;verticalLabelPosition=top;verticalAlign=bottom;labelWidth=150;" vertex="1" parent="lane_db"><mxGeometry x="1004" y="74" width="52" height="52" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b&gt;6. Refuse seats, log attempt&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;AUDIT_LOG (DENIED,&lt;br&gt;&lt;font color=&quot;undefined&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ORA-20001 / ORA-20002)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="955" y="224" width="150" height="72" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b&gt;7. Hold seats, create booking&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9.5px&quot;&gt;pkg_ticketing.sp_book_tickets&lt;/i&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;BOOKINGS (PENDING, +15 min)&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;BOOKING_ITEMS (price paid)&lt;br&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS → HELD&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;AUDIT_LOG (BOOK)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="1122" y="44" width="176" height="112" as="geometry"/></mxCell><mxCell id="t8" value="&lt;b&gt;8. Pay with MoMo or card&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_customer"><mxGeometry x="1130" y="72" width="160" height="66" as="geometry"/></mxCell><mxCell id="bt_timer" value="" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=10;labelBackgroundColor=none;outline=boundInt;symbol=timer;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="lane_customer"><mxGeometry x="1245" y="57" width="30" height="30" as="geometry"/></mxCell><mxCell id="e_expired" value="Hold expired (15 min)" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=10;labelBackgroundColor=none;outline=end;symbol=terminate2;fillColor=#FFEBEE;strokeColor=#B71C1C;labelPosition=right;align=left;verticalLabelPosition=middle;verticalAlign=middle;labelWidth=120;" vertex="1" parent="lane_customer"><mxGeometry x="1352" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="t9" value="&lt;b&gt;9. Process payment, return reference&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_pay"><mxGeometry x="1410" y="37" width="160" height="66" as="geometry"/></mxCell><mxCell id="t10" value="&lt;b&gt;10. Record payment, check amount&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9.5px&quot;&gt;pkg_ticketing.sp_record_payment&lt;/i&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;PAYMENTS (PENDING)&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;BOOKING_ITEMS (fn_booking_total)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="1512" y="58" width="196" height="84" as="geometry"/></mxCell><mxCell id="g3" value="Approved and amount = booking total?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;gwType=exclusive;whiteSpace=wrap;fontSize=10.5;fillColor=#FFFDE7;strokeColor=#8D6E00;labelBackgroundColor=none;verticalLabelPosition=top;verticalAlign=bottom;labelWidth=150;" vertex="1" parent="lane_db"><mxGeometry x="1754" y="74" width="52" height="52" as="geometry"/></mxCell><mxCell id="t11" value="&lt;b&gt;11. Reject payment, log attempt&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;PAYMENTS → FAILED&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;AUDIT_LOG (DENIED, ORA-20005)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="1682" y="224" width="196" height="72" as="geometry"/></mxCell><mxCell id="g4" value="Retry payment?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;gwType=exclusive;whiteSpace=wrap;fontSize=10.5;fillColor=#FFFDE7;strokeColor=#8D6E00;labelBackgroundColor=none;verticalLabelPosition=top;verticalAlign=bottom;labelWidth=110;" vertex="1" parent="lane_customer"><mxGeometry x="1874" y="66" width="52" height="52" as="geometry"/></mxCell><mxCell id="e_abandon" value="Payment abandoned" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=10;labelBackgroundColor=none;outline=end;symbol=terminate2;fillColor=#FFEBEE;strokeColor=#B71C1C;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=110;" vertex="1" parent="lane_customer"><mxGeometry x="1992" y="74" width="36" height="36" as="geometry"/></mxCell><mxCell id="t12" value="&lt;b&gt;12. Confirm booking, issue tickets&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9.5px&quot;&gt;pkg_ticketing.sp_record_payment&lt;/i&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;PAYMENTS → COMPLETED&lt;br&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;BOOKINGS → CONFIRMED&lt;br&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS → SOLD&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;AUDIT_LOG (PAY)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="1952" y="44" width="176" height="112" as="geometry"/></mxCell><mxCell id="s_job" value="Every minute&lt;br&gt;(DBMS_SCHEDULER)" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=10;labelBackgroundColor=none;outline=standard;symbol=timer;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalLabelPosition=bottom;verticalAlign=top;labelWidth=110;" vertex="1" parent="lane_db"><mxGeometry x="1132" y="242" width="36" height="36" as="geometry"/></mxCell><mxCell id="t13" value="&lt;b&gt;13. Release expired holds&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9.5px&quot;&gt;sp_release_expired_holds (cursor)&lt;/i&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;BOOKINGS (PENDING, expired)&lt;br&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;BOOKINGS → EXPIRED&lt;br&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS → AVAILABLE&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;AUDIT_LOG&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="1232" y="204" width="176" height="112" as="geometry"/></mxCell><mxCell id="e_released" value="Seats back on sale" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;whiteSpace=wrap;fontSize=10;labelBackgroundColor=none;outline=end;symbol=terminate2;fillColor=#FFEBEE;strokeColor=#B71C1C;labelPosition=right;align=left;verticalLabelPosition=middle;verticalAlign=middle;labelWidth=80;" vertex="1" parent="lane_db"><mxGeometry x="1422" y="312" width="36" height="36" as="geometry"/></mxCell><mxCell id="t14" value="&lt;b&gt;14. Receive e-ticket (QR code)&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS, BOOKING_ITEMS&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_customer"><mxGeometry x="2140" y="76" width="160" height="58" as="geometry"/></mxCell><mxCell id="t15" value="&lt;b&gt;15. Arrive on event day, show QR&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_customer"><mxGeometry x="2320" y="72" width="160" height="66" as="geometry"/></mxCell><mxCell id="t16" value="&lt;b&gt;16. Scan QR code at gate&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_gate"><mxGeometry x="2500" y="37" width="160" height="66" as="geometry"/></mxCell><mxCell id="t17" value="&lt;b&gt;17. Validate ticket&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9.5px&quot;&gt;pkg_gate.sp_scan_ticket&lt;/i&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS (status, event)&lt;br&gt;&lt;font color=&quot;#1F5FA8&quot;&gt;&lt;b&gt;R&lt;/b&gt;&lt;/font&gt;&amp;nbsp;GATE_SCANS (earlier scans)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="2492" y="58" width="176" height="84" as="geometry"/></mxCell><mxCell id="g5" value="Ticket SOLD, for this event, not yet used?" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;gwType=exclusive;whiteSpace=wrap;fontSize=10.5;fillColor=#FFFDE7;strokeColor=#8D6E00;labelBackgroundColor=none;verticalLabelPosition=top;verticalAlign=bottom;labelWidth=150;" vertex="1" parent="lane_db"><mxGeometry x="2734" y="74" width="52" height="52" as="geometry"/></mxCell><mxCell id="t18" value="&lt;b&gt;18. Record admission&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;GATE_SCANS (ADMITTED)&lt;br&gt;&lt;font color=&quot;#C25E00&quot;&gt;&lt;b&gt;U&lt;/b&gt;&lt;/font&gt;&amp;nbsp;TICKETS → USED&lt;br&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt;&amp;nbsp;AUDIT_LOG (SCAN)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#333333;fillColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=4;strokeWidth=1.6;" vertex="1" parent="lane_db"><mxGeometry x="2862" y="57" width="176" height="86" as="geometry"/></mxCell><mxCell id="t19" value="&lt;b&gt;19. Record denied scan&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9.5px&quot;&gt;trg_single_entry&lt;/i&gt;&lt;div style=&quot;text-align:left;font-size:10px;margin-top:3px;line-height:1.25&quot;&gt;&lt;font color=&quot;#1B7F3B&quot;&gt;&lt;b&gt;C&lt;/b&gt